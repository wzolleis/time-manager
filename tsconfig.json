{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ],
  "exclude": [
    "netlify/edge-functions"
  ],
  "compilerOptions": {
    "types": [
      "node"
    ],
    "paths": {
      "@project/*": [
        "."
      ],
      "@/*": ["./src/*"],
      "@/features/*": [
        "./src/features/*"
      ],
      "@user/*": ["./src/features/user/*"],
      "@layout/*": ["./src/features/layout/*"]
    }
  }
}